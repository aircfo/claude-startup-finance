# macOS
.DS_Store

# Editor cruft
*.swp
.idea/
.vscode/

# Python (skills under plugins/ ship Python scripts)
__pycache__/
*.pyc

# Local docs-site builds (GitHub Pages builds the published site itself)
_site/

# claude plugin eval run output (reports, transcripts)
plugins/*/evals/results/

# Office lock files (never ship in the kit or its zip)
~$*
